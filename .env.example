# Root .env for docker-compose (copy to .env)
GROQ_API_KEY=gsk_your_key_here
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_USER_EMAIL=you@gmail.com
MAIL_MODE=hitl
MAIL_POLL_INTERVAL=30
CHATBOT_URL=http://localhost:3000/chat

# Supabase (supabase.com → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Stripe (TEST MODE)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_your_starter_id
STRIPE_PRICE_GROWTH=price_your_growth_id
STRIPE_PRICE_SCALE=price_your_scale_id

# Slack incoming webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX

# Apollo.io
APOLLO_API_KEY=your_apollo_api_key

# CAN-SPAM compliance footer
BUSINESS_NAME=Apex Digital LLC
BUSINESS_ADDRESS=600 Congress Ave, Austin, TX 78701

# Public URLs (unsubscribe links / OAuth redirects)
PUBLIC_API_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Frontend (also in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
