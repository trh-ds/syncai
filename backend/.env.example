GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=postgresql+psycopg://asdr:asdr@localhost:5432/asdr
CLIENT_COMPANY_NAME=Apex Digital
CHROMA_PATH=./chroma_data
KB_SEED_FILE=./mock_kb.txt
CORS_ORIGINS=http://localhost:3000
# Gmail OAuth (run scripts/gmail_auth.py to get refresh token)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_USER_EMAIL=you@gmail.com
# Mail bot: "auto" = send immediately, "hitl" = draft pending approval
MAIL_MODE=hitl
MAIL_POLL_INTERVAL=30
CHATBOT_URL=http://localhost:3000/chat

# Supabase (supabase.com → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# Slack (api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX

# Apollo.io (Settings → Integrations → API)
APOLLO_API_KEY=your_apollo_api_key

# CAN-SPAM compliance footer
BUSINESS_NAME=Apex Digital LLC
BUSINESS_ADDRESS=600 Congress Ave, Austin, TX 78701
